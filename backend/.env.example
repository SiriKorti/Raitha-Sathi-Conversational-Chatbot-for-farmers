# ============================================================
# Kannada Agricultural RAG Assistant — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Application Settings ----
APP_NAME="Kannada Agricultural RAG Assistant"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- LLM Settings ----
# Primary: Ollama (local, free, recommended)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# For better Kannada: try "aya" or "gemma2"
# OLLAMA_MODEL=aya

# ---- Gemini API (Optional Fallback) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- Embedding Model ----
# Multilingual model — works well for Kannada
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Alternative for better quality (slower):
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ---- FAISS Index Settings ----
FAISS_INDEX_PATH=models/faiss_index/agricultural.index
FAISS_METADATA_PATH=models/faiss_index/metadata.json
FAISS_TOP_K=5

# ---- Dataset Settings ----
DATASET_PATH=data/raw
PROCESSED_DATA_PATH=data/processed

# ---- Conversation Memory ----
# in_memory = simple Python dict (good for development)
# redis = persistent Redis-backed memory (for production)
MEMORY_BACKEND=in_memory
# REDIS_URL=redis://localhost:6379
SESSION_TIMEOUT_MINUTES=30
MAX_HISTORY_TURNS=10

# ---- Voice Pipeline ----
WHISPER_MODEL_SIZE=small
# Options: tiny, base, small, medium, large-v3
WHISPER_LANGUAGE=kn
# kn = Kannada

TTS_ENGINE=coqui
# Options: coqui, piper
COQUI_MODEL=tts_models/kn/cv/vits
PIPER_MODEL_PATH=models/piper/kn_IN-female.onnx
AUDIO_SAMPLE_RATE=16000

# ---- Database (Optional — comment out if not used) ----
# MONGODB_URI=mongodb://localhost:27017/agri_rag
# POSTGRES_URI=postgresql://user:password@localhost:5432/agri_rag

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- Fine-Tuning ----
FINE_TUNED_MODEL_PATH=models/fine_tuned/agri_embedder
TRAINING_EPOCHS=3
TRAINING_BATCH_SIZE=16

# ---- Mandi Price API (data.gov.in) ----
# Register at https://data.gov.in to get a free API key (no cost, government portal).
# Dataset: "Current Daily Price of Various Commodities from Various Markets Across India"
# Resource ID is pre-set to the correct dataset. Only MANDI_API_KEY needs to be filled.
MANDI_API_KEY=your_data_gov_in_api_key_here
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
